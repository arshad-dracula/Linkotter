    regionid: 901
    regioncode: dxb
    regionname: Dubai office
    nodes:
      - name: 901a
        regionid: 901
        hostname: @DUBAI_RELAY_HOSTNAME@
        ipv4: @DUBAI_PUBLIC_IPV4@
        stunport: 3478
        derpport: 443
        canport80: false
