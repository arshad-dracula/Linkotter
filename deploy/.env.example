# Copy to deploy/.env on each NAS and fill in. Same file format on both sites.

# --- India office (control server + India relay) ---
# Public DNS name pointing at the India office static IP.
CONTROL_HOSTNAME=link.example.com
INDIA_PUBLIC_IPV4=203.0.113.10

# --- Dubai office (Dubai relay) ---
# Public DNS name pointing at the Dubai office static IP.
DUBAI_RELAY_HOSTNAME=dxb.link.example.com
DUBAI_PUBLIC_IPV4=198.51.100.20

# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=it@example.com

# Private names devices get inside the network, e.g. nas-india.mesh.example.com.
# Must NOT be the same as, or a parent of, CONTROL_HOSTNAME.
MESH_DOMAIN=mesh.example.com

# Port on the NAS that the router forwards public TCP 443 to.
# Change only if the NAS itself already uses 443 (the router must still expose 443 publicly).
HOST_HTTPS_PORT=443

# --- This NAS's own always-on node (set per site) ---
NODE_HOSTNAME=nas-india
# Created on the control server, see deploy/README.md step 4.
NODE_AUTHKEY=
# Optional: office LAN to make reachable through this NAS, e.g. 192.168.1.0/24
LAN_ROUTES=
